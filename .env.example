# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulsewatch?schema=public"

# Base URL of the app (used for absolute links / future auth callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Market data (Iteration 3, extended Iteration 4) ------------------
# Provider implementation: "yfinance" (default; Yahoo Finance, no key),
# "simulated" (demo only), or "twelvedata" (API key required).
MARKET_DATA_PROVIDER="yfinance"
# Only used when MARKET_DATA_PROVIDER="twelvedata". Get a free key at
# https://twelvedata.com/. If unset while twelvedata is selected, every
# quote request falls back to the last stored PriceObservation (or
# UNAVAILABLE if there is none).
TWELVE_DATA_API_KEY=""
# Milliseconds to wait for a single provider request before treating it
# as failed and falling back to the last known observation.
MARKET_DATA_TIMEOUT_MS="5000"
# Quote and history requests per rolling 60s window before the in-memory
# rate limiter short-circuits to cached/unavailable data. Twelve Data's
# free tier allows 8/min.
MARKET_DATA_RATE_LIMIT_PER_MINUTE="7"

# --- Attention engine (Iteration 3) ----------------------------------
# Minimum absolute % move since the user's last-seen price to count as
# CHANGED.
ATTENTION_CHANGED_PCT="0.5"
# Minimum absolute % move to count as SIGNIFICANT. Must be >=
# ATTENTION_CHANGED_PCT.
ATTENTION_SIGNIFICANT_PCT="3"
# Display-only rounding granularity (minutes) used when phrasing "last
# known price · N min ago" text. Has no effect on STALE classification
# itself. Rarely needs changing from the default.
STALE_DISPLAY_ROUNDING_MINUTES="1"

# --- NLP intelligence (NLP course project extension) -------------
# Base URL of the standalone Python NLP service (see /nlp-service).
NLP_SERVICE_URL="http://localhost:8000"
# How long to wait for the NLP service before degrading gracefully.
NLP_SERVICE_TIMEOUT_MS="8000"
# Set to "false" to hide/disable all NLP intelligence UI and API routes
# app-wide, e.g. for running PulseWatch with zero Python dependency.
NLP_FEATURE_ENABLED="true"

# --- PulseWatch AI chatbot (unified multi-agent chat) -----------------
# LLM used by the Financial Explanation Agent (Groq Chat Completions API).
# Optional: without a key the chatbot still works, using a deterministic
# evidence-only fallback, and labels every such answer as "fallback".
GROQ_API_KEY=""
# Model id for the Financial Explanation Agent.
CHAT_LLM_MODEL="openai/gpt-oss-120b"
# Milliseconds to wait for the LLM before using the fallback.
CHAT_LLM_TIMEOUT_MS="25000"
# Max /api/chat requests per client per minute (each may cost an LLM call;
# the app has no real authentication, so this limits runaway clients).
CHAT_RATE_LIMIT_PER_MINUTE="20"

# --- Python NLP service (set in the service's own environment) -----------
# NEWS_CORPUS_PATH   Optional custom CSV/JSON/JSONL corpus. Without it,
#                    ticker news is fetched from Yahoo Finance.
# GROQ_API_KEY       Optional for legacy /api/rag/query generation only;
#                    PulseWatch AI chat uses the key above in the Next.js app.
# SENTIMENT_DATASET_PATH      Optional licensed labeled CSV for classical sentiment.
# CLASSIFICATION_DATASET_PATH Optional licensed labeled CSV for category training.
